{
  // Servicio de citas de Agenda Total: citas.solidaaplicaciones.com (lo usan las páginas)
  // y agenda.solidaaplicaciones.com/<negocio>/ (la app de la dueña, archivos en agenda/).
  "name": "solida-citas",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "citas.solidaaplicaciones.com", "custom_domain": true },
    { "pattern": "agenda.solidaaplicaciones.com", "custom_domain": true }
  ],
  // Los archivos de la app (agenda/) van empaquetados dentro del Worker: se publica en un solo paso.
  "build": { "command": "node scripts/empaquetar.mjs", "watch_dir": "agenda" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solida-citas",
      "database_id": "7b99aa8d-6b4e-4052-a673-7fcf15503992",
      "migrations_dir": "migrations"
    }
  ],
  // Una vez al día se borran las citas de hace más de 120 días; cada 15 minutos se vuelven a leer los calendarios.
  "triggers": { "crons": ["41 10 * * *", "*/15 * * * *"] },
  // Secretos (npx wrangler secret put …): SECRETO cifra las direcciones de calendario; MAESTRA da de alta negocios.
  "observability": { "enabled": true }
}
